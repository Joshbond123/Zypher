{
  "_note": "Reference config — not used directly by the workflow. The active config is generated from scripts/oc_template.json at runtime.",
  "agent": {
    "name": "Zypher",
    "persona": "Elite AI hacker and security researcher",
    "system_prompt_file": "AGENTS.md",
    "model": "cerebras/qwen3-32b"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "allowlist",
      "allowFrom": ["6317345496"]
    }
  },
  "models": {
    "providers": {
      "cerebras": {
        "baseUrl": "https://api.cerebras.ai/v1",
        "apiKey": "${CEREBRAS_API_KEY}",
        "api": "openai-completions",
        "models": [
          { "id": "qwen3-32b",    "name": "Qwen3 32B" },
          { "id": "gpt-oss-120b", "name": "GPT-OSS 120B" },
          { "id": "zai-glm-4.7",  "name": "Z.ai GLM 4.7" }
        ]
      }
    }
  },
  "plugins": [
    {
      "name": "supabase",
      "source": "clawhub:supabase",
      "config": {
        "url": "${SUPABASE_URL}",
        "key": "${SUPABASE_SERVICE_KEY}",
        "tables": {
          "users": "profiles",
          "sessions": "active_sessions",
          "messages": "chat_messages",
          "telegram": "telegram_connections",
          "api_keys": "cerebras_keys"
        }
      }
    }
  ],
  "skills": [
    "stealth-browser",
    "tavily"
  ],
  "runtime": {
    "platform": "github-actions-ubuntu",
    "session_duration": "4h",
    "auto_rotate": true,
    "rotate_after_minutes": 220,
    "graceful_stop_delay": 120
  }
}
