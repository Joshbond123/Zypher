{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "skipBootstrap": false,
      "model": {
        "primary": "cerebras/zai-glm-4.7",
        "fallbacks": [
          "cerebras-2/zai-glm-4.7",
          "cerebras-3/zai-glm-4.7",
          "cerebras-4/zai-glm-4.7",
          "cerebras/gpt-oss-120b",
          "cerebras-2/gpt-oss-120b",
          "cerebras-3/gpt-oss-120b",
          "cerebras-4/gpt-oss-120b",
          "cerebras/llama3.1-8b",
          "cerebras-2/llama3.1-8b",
          "cerebras-3/llama3.1-8b",
          "cerebras-4/llama3.1-8b"
        ]
      }
    },
    "list": [
      {
        "id": "zypher",
        "identity": {
          "name": "Zypher",
          "theme": "elite AI hacker and security researcher — full Kali Linux access, expert web research and pentesting",
          "emoji": "👾"
        }
      }
    ]
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "none"
    },
    "port": 18789,
    "bind": "loopback"
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "TELEGRAM_TOKEN_HERE",
      "dmPolicy": "allowlist",
      "allowFrom": [
        "6317345496"
      ],
      "errorPolicy": "always",
      "streaming": {
        "mode": "off"
      }
    }
  },
  "tools": {
    "profile": "full",
    "exec": {
      "timeoutSec": 300,
      "security": "full"
    },
    "web": {
      "search": {
        "provider": "tavily",
        "apiKey": "TAVILY_KEY_HERE"
      },
      "fetch": {
        "enabled": true,
        "maxChars": 60000
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "cerebras": {
        "baseUrl": "https://api.cerebras.ai/v1",
        "apiKey": "CEREBRAS_KEY_1_HERE",
        "api": "openai-completions",
        "models": [
          {
            "id": "zai-glm-4.7",
            "name": "Z.ai GLM 4.7",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 128000,
            "maxTokens": 8192
          },
          {
            "id": "gpt-oss-120b",
            "name": "GPT OSS 120B",
            "reasoning": true,
            "input": [
