{
  "gateway": {
    "mode": "local"
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": { "primary": "cerebras/llama-3.3-70b" }
    },
    "list": [
      {
        "id": "zypher",
        "identity": {
          "name": "Zypher",
          "theme": "elite AI hacker — master of stealth-browser and Tavily web research",
          "emoji": "👾"
        }
      }
    ]
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "TELEGRAM_TOKEN_HERE",
      "dmPolicy": "allowlist",
      "allowFrom": ["6317345496"]
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "cerebras": {
        "baseUrl": "https://api.cerebras.ai/v1",
        "apiKey": "CEREBRAS_KEY_HERE",
        "api": "openai-completions",
        "models": [
          { "id": "llama-3.3-70b",      "name": "Llama 3.3 70B" },
          { "id": "llama3.1-8b",         "name": "Llama 3.1 8B" },
          { "id": "qwen-3-235b-2507",    "name": "Qwen3 235B" }
        ]
      }
    }
  },
  "tools": {
    "profile": "full",
    "exec": { "timeoutSec": 120, "security": "full" },
    "web": {
      "search": { "provider": "tavily" },
      "fetch":  { "enabled": true, "maxChars": 60000 }
    }
  },
  "browser": {
    "enabled": true
  },
  "plugins": {
    "entries": {
      "tavily":  { "enabled": true },
      "browser": { "enabled": true }
    }
  },
  "logging": {
    "level": "info",
    "file": "/tmp/openclaw.log",
    "consoleLevel": "info",
    "consoleStyle": "pretty"
  }
}
