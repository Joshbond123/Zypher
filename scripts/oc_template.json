{
  "gateway": {
    "mode": "local",
    "session": {
      "errorRecovery": "soft-reset",
      "maxRetries": 3,
      "retryDelayMs": 2000
    }
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": {
        "primary": "cerebras/zai-glm-4.7",
        "fallback": "cerebras/llama3.1-8b"
      }
    },
    "list": [
      {
        "id": "zypher",
        "identity": {
          "name": "Zypher",
          "theme": "elite AI hacker — master of stealth-browser and Tavily web research",
          "emoji": "👾"
        }
      }
    ]
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "TELEGRAM_TOKEN_HERE",
      "dmPolicy": "allowlist",
      "allowFrom": [
        "6317345496"
      ]
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "cerebras": {
        "baseUrl": "https://api.cerebras.ai/v1",
        "apiKey": "CEREBRAS_KEY_HERE",
        "api": "openai-completions",
        "models": [
          {
            "id": "zai-glm-4.7",
            "name": "Z.ai GLM 4.7"
          },
          {
            "id": "gpt-oss-120b",
            "name": "GPT OSS 120B"
          },
          {
            "id": "llama3.1-8b",
            "name": "Llama 3.1 8B"
          },
          {
            "id": "qwen-3-235b-a22b-instruct-2507",
            "name": "Qwen3 235B"
          }
        ]
      }
    }
  },
  "tools": {
    "profile": "full",
    "exec": {
      "timeoutSec": 120,
      "security": "full"
    },
    "web": {
      "search": {
        "provider": "tavily",
        "apiKey": "TAVILY_KEY_HERE"
      },
      "fetch": {
        "enabled": true,
        "maxChars": 60000
      }
    }
  },
  "plugins": {
    "entries": {
      "tavily": {
        "enabled": true
      },
      "browser": {
        "enabled": true
      },
      "supabase": {
        "enabled": true,
        "config": {
          "url": "SUPABASE_URL_HERE",
          "key": "SUPABASE_KEY_HERE",
          "schema": "public",
          "tables": {
            "messages": "chat_messages",
            "memory":   "longterm_memory",
            "sessions": "active_sessions"
          }
        }
      }
    }
  },
  "logging": {
    "level": "info",
    "file": "/tmp/openclaw.log",
    "consoleLevel": "info",
    "consoleStyle": "pretty"
  }
}
