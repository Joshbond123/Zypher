{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "skipBootstrap": true,
      "systemPromptFile": "AGENTS.md",
      "model": {
        "primary": "cerebras/qwen3-32b",
        "fallbacks": [
          "cerebras/llama-3.3-70b",
          "cerebras/llama3.1-8b",
          "cerebras-2/qwen3-32b",
          "cerebras-2/llama-3.3-70b",
          "cerebras-2/llama3.1-8b",
          "cerebras-3/qwen3-32b",
          "cerebras-3/llama-3.3-70b",
          "cerebras-3/llama3.1-8b",
          "cerebras-4/qwen3-32b",
          "cerebras-4/llama-3.3-70b",
          "cerebras-4/llama3.1-8b",
          "cerebras/zai-glm-4.7",
          "cerebras/gpt-oss-120b",
          "cerebras-2/zai-glm-4.7",
          "cerebras-3/zai-glm-4.7",
          "cerebras-4/zai-glm-4.7"
        ]
      }
    },
    "list": [
      {
        "id": "zypher",
        "identity": {
          "name": "Zypher",
          "theme": "elite AI hacker and security researcher — full Kali Linux access, expert web research and pentesting",
          "emoji": "👾"
        }
      }
    ]
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "none"
    },
    "port": 18789,
    "bind": "loopback"
  },
  "channels": {
    "defaults": {
      "heartbeat": {
        "showOk": false,
        "showAlerts": true,
        "useIndicator": true
      }
    },
    "telegram": {
      "enabled": true,
      "botToken": "TELEGRAM_TOKEN_HERE",
      "dmPolicy": "allowlist",
      "allowFrom": [
        6317345496
      ],
      "streaming": {
        "mode": "block"
      },
      "pollingStallThresholdMs": 120000
    }
  },
  "tools": {
    "profile": "full",
    "exec": {
      "timeoutSec": 300,
      "security": "full"
    },
    "web": {
      "search": {
        "provider": "tavily",
        "apiKey": "TAVILY_KEY_HERE"
      },
      "fetch": {
        "enabled": true,
        "maxChars": 60000
      }
    },
    "browser": {
      "enabled": true,
      "headless": true,
      "timeout": 90000,
      "retries": 3
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "cerebras": {
        "baseUrl": "https://api.cerebras.ai/v1",
        "apiKey": "CEREBRAS_KEY_1_HERE",
        "api": "openai-chat-completions",
        "timeoutSeconds": 300,
        "models": [
          {
            "id": "llama3.1-8b",
            "name": "Llama 3.1 8B",
            "reasoning": false,
            "input": [
              "text"
            ],
            "contextWindow": 128000,
            "maxTokens": 8192
          },
