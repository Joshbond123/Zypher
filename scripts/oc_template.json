{
  "gateway": {
    "mode": "local"
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": { "primary": "cerebras/qwen3-32b" }
    },
    "list": [
      {
        "id": "zypher",
        "identity": {
          "name": "Zypher",
          "theme": "elite AI hacker — master of stealth-browser and Tavily web research",
          "emoji": "👾"
        }
      }
    ]
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "TELEGRAM_TOKEN_HERE",
      "dmPolicy": "allowlist",
      "allowFrom": ["6317345496"]
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "cerebras": {
        "baseUrl": "https://api.cerebras.ai/v1",
        "apiKey": "CEREBRAS_KEY_HERE",
        "api": "openai-completions",
        "models": [
          { "id": "qwen3-32b",     "name": "Qwen3 32B" },
          { "id": "gpt-oss-120b",  "name": "GPT-OSS 120B" },
          { "id": "zai-glm-4.7",   "name": "Z.ai GLM 4.7" },
          { "id": "llama3.1-8b",   "name": "Llama 3.1 8B" }
        ]
      }
    }
  },
  "tools": {
    "profile": "full",
    "exec": { "timeoutSec": 120, "security": "full" },
    "web": {
      "search": { "provider": "tavily" },
      "fetch":  { "enabled": true, "maxChars": 60000 }
    }
  },
  "browser": {
    "enabled": true,
    "headless": true,
    "profiles": {
      "openclaw": {
        "headless": true,
        "color": "green"
      }
    }
  },
  "plugins": {
    "entries": {
      "tavily":  { "enabled": true, "config": { "apiKey": "TAVILY_KEY_HERE" } },
      "browser": { "enabled": true }
    }
  },
  "logging": {
    "level": "info",
    "file": "/tmp/openclaw.log",
    "consoleLevel": "info",
    "consoleStyle": "pretty"
  }
}
