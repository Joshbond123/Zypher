{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "skipBootstrap": false,
      "models": {
        "cerebras/zai-glm-4.7": {
          "alias": "Cerebras GLM 4.7"
        },
        "cerebras/llama3.1-8b": {
          "alias": "Cerebras Llama 3.1 8B"
        }
      },
      "model": {
        "primary": "cerebras/zai-glm-4.7"
      }
    },
    "list": [
      {
        "id": "zypher",
        "identity": {
          "name": "Zypher",
          "theme": "elite AI assistant — skilled at web research and technical tasks",
          "emoji": "👾"
        }
      }
    ]
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "none"
    },
    "port": 18789,
    "bind": "loopback"
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "TELEGRAM_TOKEN_HERE",
      "dmPolicy": "allowlist",
      "allowFrom": [
        "6317345496"
      ]
    }
  },
  "tools": {
    "profile": "full",
    "exec": {
      "timeoutSec": 120,
      "security": "full"
    },
    "web": {
      "search": {
        "provider": "tavily",
        "apiKey": "TAVILY_KEY_HERE"
      },
      "fetch": {
        "enabled": true,
        "maxChars": 60000
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "cerebras": {
        "baseUrl": "https://api.cerebras.ai/v1",
        "apiKey": "CEREBRAS_KEY_HERE",
        "api": "openai-completions",
        "models": [
          {
            "id": "zai-glm-4.7",
            "name": "Z.ai GLM 4.7",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 8192
          },
          {
            "id": "gpt-oss-120b",
            "name": "GPT OSS 120B",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 8192
          },
          {
            "id": "llama3.1-8b",
            "name": "Llama 3.1 8B",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 8192
          },
          {
            "id": "qwen-3-235b-a22b-instruct-2507",
            "name": "Qwen 3 235B Instruct",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "plugins": {
    "entries": {
      "cerebras": {
        "enabled": true
      },
      "tavily": {
        "enabled": true
      },
      "browser": {
        "enabled": true
      },
      "supabase": {
        "enabled": true,
        "config": {
          "url": "SUPABASE_URL_HERE",
          "key": "SUPABASE_KEY_HERE",
          "schema": "public",
          "tables": {
            "messages": "chat_messages",
            "memory":   "longterm_memory",
            "sessions": "active_sessions"
          }
        }
      }
    }
  },
  "logging": {
    "level": "info",
    "file": "/tmp/openclaw.log",
    "consoleLevel": "info",
    "consoleStyle": "pretty"
  }
}
